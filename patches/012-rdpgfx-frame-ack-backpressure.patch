+
+int guac_display_layer_h264_backlog(guac_display_layer* layer) {
+
+    if (layer == NULL)
+        return 0;
+
+    int backlog = 0;
+
+    pthread_mutex_lock(&layer->h264_queue_lock);
+
+    /* Count only main-view frames. An AVC444 picture is queued as two entries,
+     * a main view and the auxiliary view refining its chroma, so the raw queue
+     * length counts one frame of video twice and would halve the effective
+     * backlog for callers pacing themselves against it. */
+    for (struct guac_h264_frame* current = layer->h264_queue;
+            current != NULL; current = current->next) {
+        if (current->view == GUAC_H264_VIEW_MAIN)
+            backlog++;
+    }
+
+    pthread_mutex_unlock(&layer->h264_queue_lock);
+
+    return backlog;
+
+}
