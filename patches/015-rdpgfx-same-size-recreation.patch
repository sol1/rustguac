+/**
+ * Returns this surface's slot, or NULL if it has none and none is free.
+ */
+static guac_rdp_gfx_surface* guac_rdp_gfx_surface_slot(
+        guac_rdp_client* rdp_client, UINT16 id, int allocate) {
+
+    int free_slot = -1;
+
+    for (int i = 0; i < GUAC_RDP_GFX_MAX_SURFACES; i++) {
+
+        if (rdp_client->gfx_surfaces[i].valid
+                && rdp_client->gfx_surfaces[i].id == id)
+            return &rdp_client->gfx_surfaces[i];
+
+        if (!rdp_client->gfx_surfaces[i].valid && free_slot < 0)
+            free_slot = i;
+
+    }
+
+    if (!allocate || free_slot < 0)
+        return NULL;
+
+    rdp_client->gfx_surfaces[free_slot].id = id;
+    rdp_client->gfx_surfaces[free_slot].valid = 1;
+    rdp_client->gfx_surfaces[free_slot].deleted = 0;
+    rdp_client->gfx_surfaces[free_slot].width = 0;
+    rdp_client->gfx_surfaces[free_slot].height = 0;
+    return &rdp_client->gfx_surfaces[free_slot];
+
+}
