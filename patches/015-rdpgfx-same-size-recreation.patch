+/**
+ * Wrapper for the RDPGFX CreateSurface callback, which notes whether it
+ * recreates a surface at the size that surface already had, and then defers to
+ * FreeRDP's own handler.
+ *
+ * A same-size recreation is the one shape after which Windows does *not*
+ * repaint the whole screen, so its first picture is black over a surface the
+ * browser is still displaying correctly. See gfx_surface_recreated in rdp.h.
+ */
+static UINT guac_rdp_gfx_create_surface(RdpgfxClientContext* context,
+        const RDPGFX_CREATE_SURFACE_PDU* pdu) {
+
+    rdpGdi* gdi = (rdpGdi*) context->custom;
+    guac_client* client = ((rdp_freerdp_context*) gdi->context)->client;
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    if (pdu != NULL) {
+
+        /* Kept per surface ID rather than as one most-recently-deleted
+         * record, because a session holds several surfaces and tears them
+         * down together: deleting 1 and then 0 before recreating 0 is an
+         * ordinary resize sequence, and a single record would have been
+         * overwritten by the unrelated delete. */
+        guac_rdp_gfx_surface* slot =
+                guac_rdp_gfx_surface_slot(rdp_client, pdu->surfaceId, 1);
+
+        if (slot != NULL) {
+
+            if (slot->deleted && slot->width == pdu->width
+                    && slot->height == pdu->height) {
+
+                rdp_client->gfx_surface_recreated = 1;
+
+                guac_client_log(client, GUAC_LOG_INFO,
+                        "RDPGFX surface %u recreated at the size it already "
+                        "had (%ux%u). Its first picture describes an empty "
+                        "surface, which the client is told not to paint over "
+                        "a display it is still holding correctly.",
+                        pdu->surfaceId, pdu->width, pdu->height);
+
+            }
+
+            slot->width = pdu->width;
+            slot->height = pdu->height;
+            slot->deleted = 0;
+
+        }
+
+    }
+
+    pcRdpgfxCreateSurface orig =
+            (pcRdpgfxCreateSurface) rdp_client->orig_create_surface;
+    if (orig != NULL)
+        return orig(context, pdu);
+
+    return CHANNEL_RC_OK;
+
+}
+
+/**
+ * Wrapper for the RDPGFX DeleteSurface callback, which records the size of the
+ * surface being deleted -- its PDU carries only an ID -- so that the creation
+ * which follows can be recognised as a same-size recreation. Then defers to
+ * FreeRDP's own handler.
+ */
+static UINT guac_rdp_gfx_delete_surface(RdpgfxClientContext* context,
+        const RDPGFX_DELETE_SURFACE_PDU* pdu) {
+
+    rdpGdi* gdi = (rdpGdi*) context->custom;
+    guac_client* client = ((rdp_freerdp_context*) gdi->context)->client;
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    if (pdu != NULL) {
+
+        /* The slot is marked rather than freed, so the size this surface had
+         * survives until the same ID is created again. Windows sends the
+         * delete twice in practice; the second finds the slot already marked
+         * and leaves the recorded size alone. */
+        guac_rdp_gfx_surface* slot =
+                guac_rdp_gfx_surface_slot(rdp_client, pdu->surfaceId, 0);
+
+        if (slot != NULL)
+            slot->deleted = 1;
+
+    }
+
+    pcRdpgfxDeleteSurface orig =
+            (pcRdpgfxDeleteSurface) rdp_client->orig_delete_surface;
+    if (orig != NULL)
+        return orig(context, pdu);
+
+    return CHANNEL_RC_OK;
+
+}
