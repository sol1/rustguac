+ */
+#define GUAC_RDP_MAX_DESKTOP_SCALE 500
+
+/**
+ * Clamps a requested DPI scaling percentage to the range a desktopScaleFactor
+ * may occupy, without snapping it.
+ *
+ * Unlike deviceScaleFactor, desktopScaleFactor is legal anywhere in 100-500
+ * (MS-RDPBCGR 2.2.1.3.2, MS-RDPEDISP 2.2.2.2.1), so a channel that carries the
+ * two independently can ask for the exact scaling rather than the nearest of
+ * three. Only the display-control layout can: the connection-time core data
+ * goes through FreeRDP's monitor synthesis, which transposes the pair.
+ *
+ * @param desktop_scale
+ *     The requested scaling percentage.
+ *
+ * @return
+ *     The same percentage, clamped to the legal range.
+ */
+int guac_rdp_clamp_desktop_scale(int desktop_scale);
+
+/**
+ * Snaps a requested DPI scaling percentage to one the RDP protocol and FreeRDP
+ * can actually deliver: 100, 140 or 180. See the implementation for why no
+ * other value survives.
+ *
+ * @param desktop_scale
+ *     The requested scaling percentage.
+ *
+ * @return
+ *     The nearest percentage that will actually take effect.
+ */
+int guac_rdp_normalize_desktop_scale(int desktop_scale);
+
