 }
 
+/**
+ * Snaps a requested DPI scaling percentage to one FreeRDP can actually deliver.
+ *
+ * Only 100, 140 and 180 are usable, for two compounding reasons. MS-RDPBCGR
+ * 2.2.1.3.2 already restricts deviceScaleFactor to exactly those three, and a
+ * server discards the desktop factor along with an out-of-range device factor
+ * rather than degrading. On top of that, FreeRDP transposes the pair when it
+ * synthesises the single-monitor definition every windowed session uses
+ * (libfreerdp/core/settings.c, introduced in 401f81683 and present through
+ * 3.x): the monitor's desktopScaleFactor is filled from FreeRDP_DeviceScale-
+ * Factor and its deviceScaleFactor from FreeRDP_DesktopScaleFactor. Any pair
+ * of differing values therefore reaches the server backwards, and a request
+ * for 200% arrives as deviceScaleFactor=200 -- illegal, so silently ignored.
+ *
+ * Setting both factors to the same value is immune to the transposition, which
+ * is why FreeRDP's own /scale option accepts only these three and sets both at
+ * once. Doing the same is the only combination that survives the journey.
+ *
+ * @param desktop_scale
+ *     The requested scaling percentage.
+ *
+ * @return
+ *     The nearest percentage that will actually take effect.
+ */
+int guac_rdp_normalize_desktop_scale(int desktop_scale) {
+
+    if (desktop_scale >= 160)
+        return 180;
+
+    if (desktop_scale >= 120)
+        return 140;
+
+    return 100;
+
+}
+
+int guac_rdp_clamp_desktop_scale(int desktop_scale) {
+
+    if (desktop_scale > GUAC_RDP_MAX_DESKTOP_SCALE)
+        return GUAC_RDP_MAX_DESKTOP_SCALE;
+
+    if (desktop_scale < GUAC_RDP_MIN_DESKTOP_SCALE)
+        return GUAC_RDP_MIN_DESKTOP_SCALE;
+
+    return desktop_scale;
+
+}
+
 void guac_rdp_push_settings(guac_client* client,
         guac_rdp_settings* guac_settings, freerdp* rdp) {
 
@@ -1633,6 +1704,31 @@ void guac_rdp_push_settings(guac_client* client,
 
     /* Session */
 
+    /* DPI scaling of the remote session. Both factors travel in the client
+     * core data (MS-RDPBCGR 2.2.1.3.2) and the server ignores the pair unless
+     * desktopScaleFactor is 100-500 AND deviceScaleFactor is exactly 100, 140
+     * or 180, so an out-of-range device factor silently disables scaling
+     * altogether rather than falling back. Mirror FreeRDP's own /scale, which
+     * sets both together for the three values it accepts, and otherwise sets
+     * only the desktop factor -- what a client at, say, 200% actually sends. */
+    if (guac_settings->desktop_scale != 0) {
+
+        int scale = guac_rdp_normalize_desktop_scale(guac_settings->desktop_scale);
+
+        freerdp_settings_set_uint32(rdp_settings, FreeRDP_DesktopScaleFactor, scale);
+        freerdp_settings_set_uint32(rdp_settings, FreeRDP_DeviceScaleFactor, scale);
+
+        if (scale != guac_settings->desktop_scale)
+            guac_client_log(client, GUAC_LOG_INFO,
+                    "Requested DPI scaling of %i%% is not one the RDP "
+                    "protocol can carry; using %i%% instead.",
+                    guac_settings->desktop_scale, scale);
+        else
+            guac_client_log(client, GUAC_LOG_INFO,
+                    "Requesting %i%% DPI scaling from the RDP server.", scale);
+
+    }
+
     freerdp_settings_set_uint32(rdp_settings, FreeRDP_DesktopWidth, guac_settings->width);
     freerdp_settings_set_uint32(rdp_settings, FreeRDP_DesktopHeight, guac_settings->height);
     freerdp_settings_set_uint32(rdp_settings, FreeRDP_ColorDepth, guac_settings->color_depth);
@@ -1914,6 +2010,19 @@ void guac_rdp_push_settings(guac_client* client,
 
     /* Session */
     rdp_settings->ColorDepth = guac_settings->color_depth;
+    /* DPI scaling of the remote session -- see the FreeRDP 3 path above. */
+    if (guac_settings->desktop_scale != 0) {
+
+        int scale = guac_rdp_normalize_desktop_scale(guac_settings->desktop_scale);
+
+        rdp_settings->DesktopScaleFactor = scale;
+        rdp_settings->DeviceScaleFactor = scale;
+
+        guac_client_log(client, GUAC_LOG_INFO,
+                "Requesting %i%% DPI scaling from the RDP server.", scale);
+
+    }
+
     rdp_settings->DesktopWidth = guac_settings->width;
     rdp_settings->DesktopHeight = guac_settings->height;
     rdp_settings->AlternateShell = guac_strdup(guac_settings->initial_program);
