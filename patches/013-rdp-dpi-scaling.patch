index 1acad6ed..9e182609 100644
--- a/src/protocols/rdp/channels/disp.c
+++ b/src/protocols/rdp/channels/disp.c
@@ -388,6 +388,39 @@ void guac_rdp_disp_update_size(guac_rdp_disp* disp,
 
     else if (settings->resize_method == GUAC_RESIZE_DISPLAY_UPDATE) {
 
+        /* Repeat the DPI scaling on every layout update. The scale factors
+         * negotiated at connection time are not sticky: a MONITOR_LAYOUT
+         * carrying zeroes (MS-RDPEDISP 2.2.2.2.1 requires 100-500 and one of
+         * 100/140/180, so zero is out of range either way) drops the session
+         * back to 100%. A client that resizes shortly after connecting -- as
+         * one fitting the remote display to a browser window does -- therefore
+         * lost its scaling a second later, having applied it correctly at
+         * first.
+         *
+         * Zero remains the value sent when no scaling was requested, leaving
+         * an unscaled session behaving exactly as before.
+         *
+         * **The two factors are not the same number here.** MS-RDPEDISP
+         * 2.2.2.2.1 allows DesktopScaleFactor anywhere in 100-500 and restricts
+         * only DeviceScaleFactor to 100, 140 or 180, so the exact scaling can
+         * be asked for on this channel even though the connection-time core
+         * data cannot carry it -- FreeRDP transposes that pair while
+         * synthesising its single-monitor definition, which is what forces
+         * both to the same snapped value there (see
+         * guac_rdp_normalize_desktop_scale). This layout is built here and
+         * handed straight to the channel, so nothing transposes it.
+         *
+         * That matters at a device pixel ratio the snapped values cannot
+         * express. A framebuffer sized for a 2.0 display paired with 180%
+         * scaling draws its UI about 10% smaller than it should be; asking for
+         * 200% here corrects it, while DeviceScaleFactor stays at the nearest
+         * legal 180 as the specification requires. */
+        int scale = settings->desktop_scale != 0
+                ? guac_rdp_normalize_desktop_scale(settings->desktop_scale) : 0;
+
+        int desktop_scale = settings->desktop_scale != 0
+                ? guac_rdp_clamp_desktop_scale(settings->desktop_scale) : 0;
+
         /* Multi-monitor: send the full client-requested monitor layout and
          * republish it to the client so it can split the combined framebuffer */
         if (disp->monitor_count > 1) {
@@ -407,8 +440,8 @@ void guac_rdp_disp_update_size(guac_rdp_disp* disp,
                     .PhysicalWidth = 0,
                     .PhysicalHeight = 0,
                     .Orientation = 0,
-                    .DesktopScaleFactor = 0,
-                    .DeviceScaleFactor = 0
+                    .DesktopScaleFactor = desktop_scale,
+                    .DeviceScaleFactor = scale
                 };
             }
 
@@ -435,8 +468,8 @@ void guac_rdp_disp_update_size(guac_rdp_disp* disp,
                 .PhysicalWidth = 0,
                 .PhysicalHeight = 0,
                 .Orientation = 0,
-                .DesktopScaleFactor = 0,
-                .DeviceScaleFactor = 0
+                .DesktopScaleFactor = desktop_scale,
+                .DeviceScaleFactor = scale
             }};
 
             /* Send display update notification if display channel is connected */
