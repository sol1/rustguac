+/**
+ * Checks whether an H.264 access unit contains an IDR slice, and optionally
+ * reports the set of NAL unit types present.
+ *
+ * Only an IDR slice (type 5) makes a frame independently decodable. An SPS
+ * (type 7) is a parameter set that encoders commonly repeat alongside ordinary
+ * inter-coded frames, so treating it as sufficient marks delta frames as
+ * keyframes. That flag becomes the WebCodecs EncodedVideoChunk type on the
+ * client, and handing a decoder a delta frame labelled "key" makes it discard
+ * queued work -- dropping already-allocated VideoFrames before they reach
+ * close(), and stalling playback until a genuine sync point arrives.
+ *
+ * @param data
+ *     The Annex B access unit to inspect.
+ *
+ * @param length
+ *     The length of data, in bytes.
+ *
+ * @param types_seen
+ *     If non-NULL, receives a bitmask of the NAL unit types encountered, where
+ *     bit N corresponds to type N. Types above 31 are not represented.
+ *
+ * @return
+ *     Non-zero if an IDR slice is present, zero otherwise.
+ */
+static int guac_rdp_h264_is_keyframe(const BYTE* data, UINT32 length,
+        UINT32* types_seen) {
+
+    int has_idr = 0;
+
+    if (types_seen != NULL)
+        *types_seen = 0;
+
+    for (UINT32 i = 0; i + 3 < length; i++) {
+        if (data[i] == 0 && data[i+1] == 0) {
+            int offset = -1;
+            if (data[i+2] == 1)
+                offset = i + 3;
+            else if (i + 4 < length && data[i+2] == 0 && data[i+3] == 1)
+                offset = i + 4;
+            if (offset >= 0 && (UINT32) offset < length) {
+                int nal_type = data[offset] & 0x1F;
+                if (types_seen != NULL && nal_type < 32)
+                    *types_seen |= (1u << nal_type);
+                if (nal_type == 5)
+                    has_idr = 1;
+            }
+        }
+    }
+
+    return has_idr;
+
+}
