+/**
+ * Wrapper for the RDPGFX CapsConfirm callback. Logs the capability version the
+ * server selected, which is otherwise invisible and determines how the session
+ * will behave.
+ *
+ * The AVC_THINCLIENT flag that requests AVC420 instead of AVC444 is only
+ * attached to capability sets from version 10.3 onward -- FreeRDP builds the
+ * V10, V10.1 and V10.2 sets before adding it. So a server that confirms one of
+ * those three never saw the request, and will send AVC444 regardless of what
+ * was intended. Without this log, that case is indistinguishable from a server
+ * that saw the flag and ignored it.
+ */
+static UINT guac_rdp_gfx_caps_confirm(RdpgfxClientContext* context,
+        const RDPGFX_CAPS_CONFIRM_PDU* capsConfirm) {
+
+    rdpGdi* gdi = (rdpGdi*) context->custom;
+    guac_client* client = ((rdp_freerdp_context*) gdi->context)->client;
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    if (capsConfirm != NULL && capsConfirm->capsSet != NULL) {
+
+        UINT32 version = capsConfirm->capsSet->version;
+        UINT32 flags = capsConfirm->capsSet->flags;
+
+        guac_client_log(client, GUAC_LOG_INFO,
+                "RDPGFX capability version 0x%08X confirmed by server "
+                "(flags 0x%08X). AVC420_ENABLED=%s AVC_DISABLED=%s "
+                "AVC_THINCLIENT=%s", version, flags,
+                (flags & 0x00000010) ? "yes" : "no",
+                (flags & 0x00000020) ? "yes" : "no",
+                (flags & 0x00000040) ? "yes" : "no");
+
+        /* 0x000A0003 is RDPGFX_CAPVERSION_103 */
+        if (version < 0x000A0003)
+            guac_client_log(client, GUAC_LOG_WARNING,
+                    "Server confirmed an RDPGFX capability version below 10.3, "
+                    "which predates the AVC_THINCLIENT flag. The request for "
+                    "AVC420 was never sent, so the server may send AVC444. Set "
+                    "GUAC_RDP_H264_CAPS_FILTER=1 to advertise only 10.3 and "
+                    "later.");
+
+    }
+
+    pcRdpgfxCapsConfirm orig =
+            (pcRdpgfxCapsConfirm) rdp_client->orig_caps_confirm;
+
+    if (orig != NULL)
+        return orig(context, capsConfirm);
+
+    return CHANNEL_RC_OK;
+
+}
