+/**
+ * Sends raw H.264 NAL unit data from the given layer to all connected clients
+ * as a custom "h264" instruction followed by blob data and an end instruction.
+ * After sending, the layer's H.264 data is freed and set to NULL.
+ *
+ * @param client
+ *     The Guacamole client to send to.
+ *
+ * @param socket
+ *     The socket to write instructions to.
+ *
+ * @param layer
+ *     The display layer containing H.264 data to send.
+ */
+/**
+ * Sends a single H.264 frame to all connected clients as a custom "h264"
+ * instruction followed by blob data and an end instruction.
+ */
+/**
+ * Writes a single integer as a length-prefixed argument of the Guacamole
+ * instruction currently being written to the given socket.
+ */
+static void guac_h264_write_arg(guac_socket* socket, int value) {
+
+    char buf[16];
+    char len_buf[8];
+
+    int n = snprintf(buf, sizeof(buf), "%d", value);
+    snprintf(len_buf, sizeof(len_buf), ",%d.", n);
+
+    guac_socket_write_string(socket, len_buf);
+    guac_socket_write_string(socket, buf);
+
+}
+
+static void guac_display_plan_send_h264_frame(guac_client* client,
+        guac_socket* socket, guac_display_layer* layer,
+        struct guac_h264_frame* frame) {
+
+    guac_stream* stream = guac_client_alloc_stream(client);
+
+    /* Build h264 instruction:
+     *
+     *   h264 <stream> <layer> <keyframe> <x> <y> <width> <height>
+     *        <view> <numrects> [<x> <y> <width> <height>]...
+     *
+     * <view> identifies what the access unit carries: 0 is a displayable
+     * picture (AVC420, or the main view of AVC444), 1 and 2 are the auxiliary
+     * chroma views of AVC444 in its v1 and v2 layouts. An auxiliary view is
+     * not an image and MUST NOT be drawn, but it MUST still be decoded: both
+     * views belong to one H.264 sequence, and skipping either leaves later
+     * pictures referencing data the decoder never received.
+     *
+     * The trailing region rects identify which parts of the decoded picture
+     * are actually valid. A client MUST draw only those regions; the picture
+     * is full-surface sized, and on a server that mixes codecs the remainder
+     * holds no meaningful content. A count of zero means the whole picture is
+     * valid, which is the case for servers (such as xrdp) that encode the
+     * entire surface as H.264. */
+    int header[] = {
+        stream->index,
+        layer->layer->index,
+        frame->is_keyframe,
+        frame->rect.left,
+        frame->rect.top,
+        guac_rect_width(&frame->rect),
+        guac_rect_height(&frame->rect)
+    };
+
+    guac_socket_instruction_begin(socket);
+    guac_socket_write_string(socket, "4.h264");
+
+    for (int i = 0; i < 7; i++)
+        guac_h264_write_arg(socket, header[i]);
+
+    guac_h264_write_arg(socket, frame->view);
+    guac_h264_write_arg(socket, frame->num_rects);
+
+    for (int i = 0; i < frame->num_rects; i++) {
+        guac_rect* rect = &frame->rects[i];
+        guac_h264_write_arg(socket, rect->left);
+        guac_h264_write_arg(socket, rect->top);
+        guac_h264_write_arg(socket, guac_rect_width(rect));
+        guac_h264_write_arg(socket, guac_rect_height(rect));
+    }
+
+    guac_socket_write_string(socket, ";");
+    guac_socket_instruction_end(socket);
+
+    /* Send H.264 NAL unit data as blob stream */
+    guac_protocol_send_blobs(socket, stream, frame->data, frame->length);
+    guac_protocol_send_end(socket, stream);
+    guac_client_free_stream(client, stream);
+
+}
+
+/**
+ * Sends all queued H.264 frames from the given layer to connected clients,
+ * freeing each frame after sending. Frames are sent in order to preserve
+ * the H.264 reference chain.
+ *
+ * @return
+ *     The number of frames sent.
+ */
+static int guac_display_plan_flush_h264(guac_client* client,
+        guac_socket* socket, guac_display_layer* layer) {
+
+    int sent = 0;
+
+    /* Detach the whole queue up front rather than walking it in place. The
+     * protocol thread may append to the queue at any time, and sending
+     * involves socket writes -- holding the queue lock across those would
+     * reintroduce exactly the stall this lock exists to avoid. Frames appended
+     * during the send are simply carried by the next flush. */
+    pthread_mutex_lock(&layer->h264_queue_lock);
+
+    struct guac_h264_frame* frame = layer->h264_queue;
+    layer->h264_queue = NULL;
+    layer->h264_queue_tail = NULL;
+    layer->h264_queue_length = 0;
+
+    pthread_mutex_unlock(&layer->h264_queue_lock);
+
+    while (frame != NULL) {
+        struct guac_h264_frame* next = frame->next;
+
+        /* Skip P-frames until first keyframe has been sent */
+        if (!frame->is_keyframe && !layer->h264_keyframe_sent) {
+            guac_client_log(client, GUAC_LOG_DEBUG,
+                    "H.264: dropping %u byte delta (no keyframe yet)",
+                    frame->length);
+            guac_mem_free(frame->data);
+            guac_mem_free(frame->rects);
+            guac_mem_free(frame);
+            frame = next;
+            continue;
+        }
+
+        guac_display_plan_send_h264_frame(client, socket, layer, frame);
+
+        if (frame->is_keyframe)
+            layer->h264_keyframe_sent = 1;
+
+        guac_client_log(client, GUAC_LOG_DEBUG,
+                "H.264: sent %u bytes, %s, %dx%d",
+                frame->length,
+                frame->is_keyframe ? "KEYFRAME" : "delta",
+                guac_rect_width(&frame->rect),
+                guac_rect_height(&frame->rect));
+
+        guac_mem_free(frame->data);
+        guac_mem_free(frame->rects);
+        guac_mem_free(frame);
+        frame = next;
+        sent++;
+    }
+
+    if (sent > 0)
+        guac_client_log(client, GUAC_LOG_DEBUG,
+                "H.264 passthrough: flushed %d frames", sent);
+
+    return sent;
+
+}
+
+int PFW_guac_display_flush_h264(guac_display* display) {
+
+    guac_client* client = display->client;
+    int sent_any = 0;
+
+    /* Walk the layers of the pending frame directly rather than the display
+     * plan. A layer carrying an H.264 stream may have no plan operations at
+     * all (that is the entire point of skipping the decode), and with no dirty
+     * pixels anywhere guac_display_plan_create() returns NULL and
+     * guac_display_plan_apply() is never reached. */
+    for (guac_display_layer* layer = display->pending_frame.layers;
+            layer != NULL; layer = layer->pending_frame.next) {
+
+        /* No unlocked pre-check for an empty queue here: the protocol thread
+         * may be appending concurrently, and guac_display_plan_flush_h264()
+         * takes the queue lock and returns zero for an empty queue anyway. */
+        if (guac_display_plan_flush_h264(client, client->socket, layer) > 0)
+            sent_any = 1;
+
+    }
+
+    return sent_any;
+
+}
