+/**
+ * Wrapper for the FreeRDP GDI SurfaceCommand callback. Intercepts AVC420
+ * and AVC444 commands to store raw H.264 NAL units on the display layer
+ * for passthrough to clients during the next frame flush.
+ *
+ * The original handler is always called to perform GDI decoding, which
+ * updates the pixel buffer and dirty tracking. The H.264 data is sent
+ * to clients by the display worker pipeline (in guac_display_plan_apply)
+ * instead of encoding the pixel data as JPEG/PNG/WebP.
+ */
+static UINT guac_rdp_gfx_surface_command(RdpgfxClientContext* context,
+        const RDPGFX_SURFACE_COMMAND* cmd) {
+
+    /* gfx->custom points to rdpGdi (set by gdi_graphics_pipeline_init) */
+    rdpGdi* gdi = (rdpGdi*) context->custom;
+    rdpContext* rdp_context = gdi->context;
+    guac_client* client = ((rdp_freerdp_context*) rdp_context)->client;
+    guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
+
+    /* Log the codec of every surface command, not just H.264 ones. Without
+     * this there is no way to tell a server that is sending no H.264 from one
+     * that is mixing H.264 with progressive/clear/planar commands -- both look
+     * identical from the H.264-only trace output. Codec IDs are those of
+     * MS-RDPEGFX (see RDPGFX_CODECID_* in freerdp/channels/rdpgfx.h), in
+     * decimal: 0=UNCOMPRESSED, 3=CAVIDEO(RFX), 8=CLEARCODEC, 9=CAPROGRESSIVE,
+     * 10=PLANAR, 11=AVC420, 12=ALPHA, 13=CAPROGRESSIVE_V2, 14=AVC444,
+     * 15=AVC444v2. */
+    guac_client_log(client, GUAC_LOG_TRACE,
+            "GFX surface command: surface=%u, codec=%u, %ux%u at %u,%u",
+            cmd->surfaceId, cmd->codecId,
+            cmd->width, cmd->height, cmd->left, cmd->top);
+
+    /* Save H.264 NAL data BEFORE calling the original handler. The original
+     * GDI handler may free or modify cmd->extra data during AVC decoding,
+     * so we must copy it while it's still valid. */
+    /* An AVC444 command carries two views in one H.264 sequence, so a single
+     * surface command can yield two access units that must both reach the
+     * client, in order. */
+    unsigned char* saved_h264[2] = { NULL, NULL };
+    UINT32 saved_length[2] = { 0, 0 };
+    int saved_keyframe[2] = { 0, 0 };
+    guac_rect* saved_rects[2] = { NULL, NULL };
+    int saved_num_rects[2] = { 0, 0 };
+    int saved_view[2] = { GUAC_H264_VIEW_MAIN, GUAC_H264_VIEW_MAIN };
+    int saved_count = 0;
+    UINT32 saved_nal_types = 0;
+
+    if (cmd->codecId == RDPGFX_CODECID_AVC420 && cmd->extra != NULL) {
+        RDPGFX_AVC420_BITMAP_STREAM* avc420 =
+                (RDPGFX_AVC420_BITMAP_STREAM*) cmd->extra;
+        if (avc420->data != NULL && avc420->length > 0) {
+            saved_length[0] = avc420->length;
+            saved_h264[0] = malloc(saved_length[0]);
+            if (saved_h264[0] != NULL) {
+                memcpy(saved_h264[0], avc420->data, saved_length[0]);
+                saved_keyframe[0] = guac_rdp_h264_is_keyframe(
+                        saved_h264[0], saved_length[0], &saved_nal_types);
+                saved_rects[0] = guac_rdp_h264_copy_rects(&avc420->meta,
+                        &saved_num_rects[0]);
+                saved_view[0] = GUAC_H264_VIEW_MAIN;
+                saved_count = 1;
+            }
+        }
+    }
+    /* AVC444 encodes a picture as two views inside ONE H.264 sequence, and
+     * FreeRDP decodes both through the same H264_CONTEXT. Both must therefore
+     * reach the client's decoder, in order: dropping either leaves later
+     * pictures referencing data it never received, which renders as blocky
+     * wrongly-coloured macroblocks and reports no decode error, because the
+     * bitstream that does arrive is well formed.
+     *
+     * Only the main view is a displayable image. The auxiliary view carries
+     * chroma samples that refine it to 4:4:4; it is tagged so the client
+     * decodes it for its references and either merges or discards it.
+     *
+     * LC (FreeRDP's op) says which bitstreams are present:
+     *   0  main view in bitstream[0], chroma in bitstream[1]
+     *   1  main view in bitstream[0]
+     *   2  chroma in bitstream[0]
+     */
+    else if ((cmd->codecId == RDPGFX_CODECID_AVC444
+           || cmd->codecId == RDPGFX_CODECID_AVC444v2)
+           && cmd->extra != NULL) {
+
+        RDPGFX_AVC444_BITMAP_STREAM* avc444 =
+                (RDPGFX_AVC444_BITMAP_STREAM*) cmd->extra;
+
+        int chroma_view = (cmd->codecId == RDPGFX_CODECID_AVC444)
+                ? GUAC_H264_VIEW_CHROMA_V1 : GUAC_H264_VIEW_CHROMA_V2;
+
+        guac_client_log(client, GUAC_LOG_TRACE, "AVC444 LC=%u", avc444->LC);
+
+        /* bitstream[0]: main view for LC 0 and 1, chroma for LC 2 */
+        if (avc444->bitstream[0].data != NULL
+                && avc444->bitstream[0].length > 0) {
+
+            saved_length[0] = avc444->bitstream[0].length;
+            saved_h264[0] = malloc(saved_length[0]);
+
+            if (saved_h264[0] != NULL) {
+                memcpy(saved_h264[0], avc444->bitstream[0].data,
+                        saved_length[0]);
+                saved_keyframe[0] = guac_rdp_h264_is_keyframe(
+                        saved_h264[0], saved_length[0], &saved_nal_types);
+                saved_rects[0] = guac_rdp_h264_copy_rects(
+                        &avc444->bitstream[0].meta, &saved_num_rects[0]);
+                saved_view[0] = (avc444->LC == 2)
+                        ? chroma_view : GUAC_H264_VIEW_MAIN;
+                saved_count = 1;
+            }
+
+        }
+
+        /* bitstream[1]: the chroma view, present only for LC 0 */
+        if (avc444->LC == 0 && saved_count == 1
+                && avc444->bitstream[1].data != NULL
+                && avc444->bitstream[1].length > 0) {
+
+            saved_length[1] = avc444->bitstream[1].length;
+            saved_h264[1] = malloc(saved_length[1]);
+
+            if (saved_h264[1] != NULL) {
+                memcpy(saved_h264[1], avc444->bitstream[1].data,
+                        saved_length[1]);
+                saved_keyframe[1] = guac_rdp_h264_is_keyframe(
+                        saved_h264[1], saved_length[1], NULL);
+                saved_rects[1] = guac_rdp_h264_copy_rects(
+                        &avc444->bitstream[1].meta, &saved_num_rects[1]);
+                saved_view[1] = chroma_view;
+                saved_count = 2;
+            }
+
+        }
+
+    }
+
+    UINT result = CHANNEL_RC_OK;
+
+    /* Skip the software H.264 decode when this command is being passed through
+     * to the client verbatim. The decoded pixels are discarded regardless —
+     * guac_display_plan_apply() suppresses every image operation for a layer
+     * carrying an H.264 stream — so decoding them costs the libavcodec decode
+     * plus the full dirty-region diff in the display render thread, for pixels
+     * nothing will ever read.
+     *
+     * Only H.264 commands are skipped. RemoteFX, planar, and progressive
+     * commands (saved_h264 == NULL) are always decoded normally, so a session
+     * whose server mixes codecs still renders those regions.
+     *
+     * Otherwise, run the normal GDI decode — this calls BeginPaint/EndPaint
+     * internally, updates the pixel buffer, and marks the dirty region. Must
+     * happen after we've saved the H.264 data above. */
+    int skip_decode = (saved_count > 0);
+
+    if (!skip_decode) {
+        pcRdpgfxSurfaceCommand orig =
+                (pcRdpgfxSurfaceCommand) rdp_client->orig_surface_command;
+        if (orig != NULL)
+            result = orig(context, cmd);
+    }
+
+    /* Store saved H.264 data on the display layer for passthrough.
+     * guac_display_layer_set_h264 acquires pending_frame.lock internally,
+     * which is safe since EndPaint has already released it above. */
+    if (saved_count > 0) {
+        guac_display_layer* default_layer =
+                guac_display_default_layer(rdp_client->display);
+
+        /* Queued in capture order, which is the order the views occupy in the
+         * H.264 sequence. The queue preserves it through to the wire. */
+        for (int i = 0; i < saved_count; i++)
+            guac_display_layer_set_h264(default_layer,
+                    saved_h264[i], saved_length[i], saved_keyframe[i],
+                    cmd->left, cmd->top, cmd->width, cmd->height,
+                    saved_rects[i], saved_num_rects[i], saved_view[i]);
+
+        /* With the decode skipped, guac_rdp_gdi_end_paint() never runs, so
+         * nothing marks the display as modified and the queued frames would
+         * sit unsent until some unrelated update arrived. Raise exactly the
+         * flag end_paint would have raised, rather than notifying the render
+         * thread directly: the main RDP event loop batches gdi_modified into a
+         * single guac_display_render_thread_notify_modified() per message
+         * batch. Notifying per surface command instead keeps FRAME_MODIFIED
+         * permanently set at high frame rates, which prevents the render
+         * thread's frame-accumulation loop from ever settling and delays every
+         * flush until GUAC_DISPLAY_RENDER_THREAD_MAX_FRAME_DURATION (100ms). */
+        if (skip_decode)
+            rdp_client->gdi_modified = 1;
+
+        for (int i = 0; i < saved_count; i++) {
+
+            guac_client_log(client, GUAC_LOG_TRACE,
+                    "H.264 passthrough: view=%i, %u bytes, %s, "
+                    "nal_types=0x%08x, %ux%u at %u,%u, rects=%i",
+                    saved_view[i], saved_length[i],
+                    saved_keyframe[i] ? "keyframe" : "delta",
+                    saved_nal_types,
+                    cmd->width, cmd->height, cmd->left, cmd->top,
+                    saved_num_rects[i]);
+
+            /* guac_display_layer_set_h264() copies both the NAL data and the
+             * region rects, so this view's copies are ours to release. */
+            free(saved_h264[i]);
+            free(saved_rects[i]);
+
+        }
+
+    }
+
+    /* Any view that was captured but never queued must still be released */
+    else {
+        for (int i = 0; i < 2; i++) {
+            free(saved_h264[i]);
+            free(saved_rects[i]);
+        }
+    }
+
+    return result;
+}
