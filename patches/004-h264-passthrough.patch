+
+void guac_display_layer_set_h264(guac_display_layer* layer,
+        const unsigned char* data, uint32_t length, int is_keyframe,
+        int x, int y, int width, int height,
+        const guac_rect* rects, int num_rects, int view) {
+
+    int dropped = 0;
+
+    /* Build the queue entry before taking any lock. This is the expensive part
+     * (two allocations and a copy of the whole NAL unit) and it touches
+     * nothing shared, so holding a lock across it would serialise the protocol
+     * thread against the render thread for no reason. */
+    struct guac_h264_frame* frame = guac_mem_alloc(sizeof(struct guac_h264_frame));
+    frame->data = guac_mem_alloc(length);
+    memcpy(frame->data, data, length);
+    frame->length = length;
+    frame->is_keyframe = is_keyframe;
+    frame->view = view;
+    guac_rect_init(&frame->rect, x, y, width, height);
+    frame->next = NULL;
+
+    /* Copy the region rects, if any. The caller's array belongs to FreeRDP and
+     * is freed as soon as the surface command returns. */
+    if (rects != NULL && num_rects > 0) {
+        size_t rects_size = guac_mem_ckd_mul_or_die(num_rects, sizeof(guac_rect));
+        frame->rects = guac_mem_alloc(rects_size);
+        memcpy(frame->rects, rects, rects_size);
+        frame->num_rects = num_rects;
+    }
+    else {
+        frame->rects = NULL;
+        frame->num_rects = 0;
+    }
+
+    /* The queue has its own lock precisely so that this thread never waits on
+     * the render thread. See the h264_queue_lock documentation: for RDP this
+     * is the thread that acknowledges EGFX frames, and delaying it throttles
+     * the server. */
+    pthread_mutex_lock(&layer->h264_queue_lock);
+
+    /* Append to queue */
+    if (layer->h264_queue_tail != NULL)
+        layer->h264_queue_tail->next = frame;
+    else
+        layer->h264_queue = frame;
+    layer->h264_queue_tail = frame;
+    layer->h264_queue_length++;
+
+    /* Cap queue at 120 frames (~2 seconds at 60fps) to prevent unbounded
+     * growth if frame flushes are stalled. Drop oldest frame from head. */
+    while (layer->h264_queue_length > 120 && layer->h264_queue != NULL) {
+        struct guac_h264_frame* old = layer->h264_queue;
+        layer->h264_queue = old->next;
+        if (layer->h264_queue == NULL)
+            layer->h264_queue_tail = NULL;
+        guac_mem_free(old->data);
+        guac_mem_free(old->rects);
+        guac_mem_free(old);
+        layer->h264_queue_length--;
+        dropped++;
+    }
+
+    pthread_mutex_unlock(&layer->h264_queue_lock);
+
+    /* Report drops outside the lock -- logging may block on I/O, and this lock
+     * is on the path of every surface command.
+     *
+     * Dropping a frame breaks the H.264 reference chain: every subsequent
+     * inter-coded frame references data the client's decoder never received,
+     * so it discards queued work until the next IDR. That is invisible in the
+     * client's own accounting -- frames the decoder allocates and then drops
+     * never reach its output callback -- so it must be reported here. */
+    if (dropped > 0)
+        guac_client_log(layer->display->client, GUAC_LOG_WARNING,
+                "H.264 queue exceeded 120 frames; dropped %i. The reference "
+                "chain is broken until the next keyframe.", dropped);
+
+}
